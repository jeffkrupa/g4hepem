namespace {

int ReadEnvInt(const char* key, int defaultValue) {
  const char* raw = std::getenv(key);
  if (raw == nullptr || *raw == '\0') {
    return defaultValue;
  }
  char* endPtr = nullptr;
  const long parsed = std::strtol(raw, &endPtr, 10);
  if (endPtr == raw) {
    return defaultValue;
  }
  return static_cast<int>(parsed);
}

const char* ReadEnvStr(const char* key, const char* defaultValue) {
  const char* raw = std::getenv(key);
  if (raw == nullptr || *raw == '\0') {
    return defaultValue;
  }
  return raw;
}

inline double ValueOf(const G4double& v) {
  return static_cast<double>(GET_VALUE(v));
}

#if defined(CODI_FORWARD)
inline double DotOf(const G4double& v) {
  return static_cast<double>(GET_DOTVALUE(v));
}
#else
inline double DotOf(const G4double&) {
  return 0.0;
}
#endif

G4double& NumIALeftDerivativeMfpFloor() {
  static G4double floor = static_cast<G4double>(0.0);
  return floor;
}

G4double& ConversionDerivativeEpsilon() {
  static G4double epsilon = static_cast<G4double>(0.0);
  return epsilon;
}

inline G4double SignedFloorFromValue(const G4double& val, const G4double& floor) {
  if (!(GET_VALUE(floor) > 0.0)) {
    return val;
  }
  const double absVal = std::abs(GET_VALUE(val));
  if (absVal >= GET_VALUE(floor)) {
    return val;
  }
  return GET_VALUE(val) < 0.0 ? -floor : floor;
}

inline G4double PositiveFloorFromValue(const G4double& val, const G4double& floor) {
  if (!(GET_VALUE(floor) > 0.0)) {
    return val;
  }
  return GET_VALUE(val) > GET_VALUE(floor) ? val : floor;
}

inline G4double RegularizedRatioKeepPrimal(const G4double& num, const G4double& den, const G4double& denFloor) {
  if (!(GET_VALUE(denFloor) > 0.0)) {
    return num / den;
  }
  const G4double numVal = stop_grad(num);
  const G4double denVal = stop_grad(den);
  const G4double denReg = SignedFloorFromValue(denVal, denFloor);
  const G4double primal = stop_grad(numVal / denVal);
  const G4double dfdn = stop_grad(1.0 / denReg);
  const G4double dfdd = stop_grad(-numVal / (denReg * denReg));
  return primal + (num - numVal) * dfdn + (den - denVal) * dfdd;
}

inline G4double RegularizedLogOneMinusRatioKeepPrimal(const G4double& z, const G4double& lambda, const G4double& eps) {
  if (!(GET_VALUE(eps) > 0.0)) {
    return G4HepEmLog(1. - z / lambda);
  }
  const G4double zVal = stop_grad(z);
  const G4double lambdaVal = stop_grad(lambda);
  const G4double primal = stop_grad(G4HepEmLog(1. - zVal / lambdaVal));
  const G4double gapVal = lambdaVal - zVal;
  const G4double gapReg = PositiveFloorFromValue(gapVal, eps);
  const G4double lambdaReg = PositiveFloorFromValue(lambdaVal, eps);
  const G4double dfdz = stop_grad(-1.0 / gapReg);
  const G4double dfdl = stop_grad(zVal / (lambdaReg * gapReg));
  return primal + (z - zVal) * dfdz + (lambda - lambdaVal) * dfdl;
}

inline G4double RegularizedConvertParPosKeepPrimal(const G4double& par1, const G4double& par3, const G4double& zPath, const G4double& eps) {
  if (!(GET_VALUE(eps) > 0.0)) {
    const G4double dum = par1 * par3 * zPath;
    return (1. - G4HepEmPow(1. - dum, 1. / par3)) / par1;
  }
  const G4double pVal = stop_grad(par1);
  const G4double qVal = stop_grad(par3);
  const G4double zVal = stop_grad(zPath);
  const G4double dumVal = pVal * qVal * zVal;
  const G4double primal = stop_grad((1. - G4HepEmPow(1. - dumVal, 1. / qVal)) / pVal);

  const G4double pReg = SignedFloorFromValue(pVal, eps);
  const G4double qReg = SignedFloorFromValue(qVal, eps);
  const G4double bReg = PositiveFloorFromValue(1. - dumVal, eps);
  const G4double pAbsVal = static_cast<G4double>(std::abs(GET_VALUE(pVal)));
  const G4double qAbsVal = static_cast<G4double>(std::abs(GET_VALUE(qVal)));
  const G4double pAbsReg = PositiveFloorFromValue(pAbsVal, eps);
  const G4double qAbsReg = PositiveFloorFromValue(qAbsVal, eps);

  const G4double aReg = stop_grad(1.0 / qReg);
  const G4double powReg = stop_grad(G4HepEmPow(bReg, aReg));

  const G4double dfdz = stop_grad(powReg / bReg);
  const G4double dfdp = stop_grad(-(1. - powReg) / (pReg * pReg) + (powReg * zVal) / (pReg * bReg));
  const G4double dfdq = stop_grad(powReg * (zVal / (qReg * bReg) + G4HepEmLog(bReg) / (pAbsReg * qAbsReg * qAbsReg)));

  return primal + (par1 - pVal) * dfdp + (par3 - qVal) * dfdq + (zPath - zVal) * dfdz;
}

G4double RegularizedNumIADecrement(const G4double& pStepLength, const G4double& preStepMFP) {
  const G4double mfpFloor = NumIALeftDerivativeMfpFloor();
  if (!(GET_VALUE(mfpFloor) > 0.0)) {
    return pStepLength / preStepMFP;
  }

  // Keep primal exactly p/m while regularizing derivative coefficients with floored m.
  const G4double pVal = stop_grad(pStepLength);
  const G4double mVal = stop_grad(preStepMFP);
  const G4double mReg = GET_VALUE(mVal) > GET_VALUE(mfpFloor) ? mVal : mfpFloor;

  const G4double primalBase = stop_grad(pVal / mVal);
  const G4double dfdp       = stop_grad(1.0 / mReg);
  const G4double dfdm       = stop_grad(-pVal / (mReg * mReg));

  return primalBase + (pStepLength - pVal) * dfdp + (preStepMFP - mVal) * dfdm;
}

int DebugTrackId() {
  static const int kTrackId = ReadEnvInt("HEPEMSHOW_DEBUG_TRACK_ID", -1);
  return kTrackId;
}

bool IsHepEmDebugLoggingEnabled() {
  static const int kEnabled = ReadEnvInt("HEPEMSHOW_ENABLE_DEBUG_LOGS", 0);
  return kEnabled != 0;
}

bool ShouldDebugTrack(int trackId) {
  if (!IsHepEmDebugLoggingEnabled()) {
    return false;
  }
  const int wantedTrackId = DebugTrackId();
  return wantedTrackId >= 0 && trackId == wantedTrackId;
}

std::mutex& DebugLogMutex() {
  static std::mutex mtx;
  return mtx;
}

std::ofstream& DebugLogStream() {
  static std::ofstream out;
  static bool initialised = false;
  if (!initialised) {
    const char* filePath = ReadEnvStr("HEPEMSHOW_PERFORM_DEBUG_FILE", "perform_continuous_debug.csv");
    out.open(filePath, std::ios::out | std::ios::trunc);
    if (out.good()) {
      out << "trackID,parentID,stepIdx,stage,winnerIdx,onBoundary,"
          << "gStepLength,gStepLength_dot,"
          << "pStepLength,pStepLength_dot,"
          << "trueStepLength,trueStepLength_dot,"
          << "zPathLength,zPathLength_dot,"
          << "lambtr1,lambtr1_dot,"
          << "par1,par1_dot,"
          << "par2,par2_dot,"
          << "par3,par3_dot,"
          << "numIAleft0,numIAleft0_dot,"
          << "numIAleft1,numIAleft1_dot,"
          << "numIAleft2,numIAleft2_dot,"
          << "mfp0,mfp0_dot,"
          << "mfp1,mfp1_dot,"
          << "mfp2,mfp2_dot,"
          << "eKin,eKin_dot,"
          << "edep,edep_dot,"
          << "returnFlag\n";
      out.setf(std::ios::scientific);
    }
    initialised = true;
  }
  return out;
}

std::unordered_map<int, int>& DebugStepIndexMap() {
  static thread_local std::unordered_map<int, int> perTrackStep;
  return perTrackStep;
}

int GetDebugStepIndex(int trackId) {
  return DebugStepIndexMap()[trackId];
}

void AdvanceDebugStepIndex(int trackId) {
  ++DebugStepIndexMap()[trackId];
}

struct DebugTrackContext {
  bool active = false;
  int trackId = -1;
  int parentId = -1;
  int stepIdx = -1;
  int winnerIdx = -1;
  bool onBoundary = false;
};

DebugTrackContext& GetDebugTrackContext() {
  static thread_local DebugTrackContext ctx;
  return ctx;
}

void SetDebugContextFromTrack(G4HepEmTrack* theTrack, int stepIndex) {
  DebugTrackContext& ctx = GetDebugTrackContext();
  ctx.active = true;
  ctx.trackId = theTrack->GetID();
  ctx.parentId = theTrack->GetParentID();
  ctx.stepIdx = stepIndex;
  ctx.winnerIdx = theTrack->GetWinnerProcessIndex();
  ctx.onBoundary = theTrack->GetOnBoundary();
}

void ClearDebugContext() {
  GetDebugTrackContext() = DebugTrackContext{};
}

bool HasDebugContext() {
  const DebugTrackContext& ctx = GetDebugTrackContext();
  return ctx.active && ShouldDebugTrack(ctx.trackId);
}

G4double DebugNaN() {
  return static_cast<G4double>(std::numeric_limits<double>::quiet_NaN());
}

std::ofstream& ConversionDebugLogStream() {
  static std::ofstream out;
  static bool initialised = false;
  if (!initialised) {
    const char* filePath = ReadEnvStr("HEPEMSHOW_CONVERSION_DEBUG_FILE", "conversion_debug.csv");
    out.open(filePath, std::ios::out | std::ios::trunc);
    if (out.good()) {
      out << "trackID,parentID,stepIdx,stage,winnerIdx,onBoundary,"
          << "range,range_dot,"
          << "gStepToConvert,gStepToConvert_dot,"
          << "ekin,ekin_dot,"
          << "trueStepLength,trueStepLength_dot,"
          << "zPathLength,zPathLength_dot,"
          << "lambtr1,lambtr1_dot,"
          << "par1,par1_dot,"
          << "par2,par2_dot,"
          << "par3,par3_dot,"
          << "returnFlag\n";
      out.setf(std::ios::scientific);
    }
    initialised = true;
  }
  return out;
}

void LogConversionCheckpoint(const char* stage, int returnFlag, G4HepEmMSCTrackData* mscData,
                            G4double range, G4double gStepToConvert, G4double ekin) {
  if (!HasDebugContext()) {
    return;
  }
  std::ofstream& out = ConversionDebugLogStream();
  if (!out.good()) {
    return;
  }

  const DebugTrackContext& ctx = GetDebugTrackContext();
  std::lock_guard<std::mutex> lock(DebugLogMutex());
  out
    << ctx.trackId << ','
    << ctx.parentId << ','
    << ctx.stepIdx << ','
    << stage << ','
    << ctx.winnerIdx << ','
    << ctx.onBoundary << ','
    << ValueOf(range) << ',' << DotOf(range) << ','
    << ValueOf(gStepToConvert) << ',' << DotOf(gStepToConvert) << ','
    << ValueOf(ekin) << ',' << DotOf(ekin) << ','
    << ValueOf(mscData->fTrueStepLength) << ',' << DotOf(mscData->fTrueStepLength) << ','
    << ValueOf(mscData->fZPathLength) << ',' << DotOf(mscData->fZPathLength) << ','
    << ValueOf(mscData->fLambtr1) << ',' << DotOf(mscData->fLambtr1) << ','
    << ValueOf(mscData->fPar1) << ',' << DotOf(mscData->fPar1) << ','
    << ValueOf(mscData->fPar2) << ',' << DotOf(mscData->fPar2) << ','
    << ValueOf(mscData->fPar3) << ',' << DotOf(mscData->fPar3) << ','
    << returnFlag
    << '\n';
  out.flush();
}

void LogPerformContinuousCheckpoint(const char* stage, int stepIndex, int returnFlag, G4HepEmElectronTrack* theElTrack) {
  G4HepEmTrack* theTrack = theElTrack->GetTrack();
  const int trackId = theTrack->GetID();
  if (!ShouldDebugTrack(trackId)) {
    return;
  }
  SetDebugContextFromTrack(theTrack, stepIndex);
  std::ofstream& out = DebugLogStream();
  if (!out.good()) {
    return;
  }

  G4HepEmMSCTrackData* mscData = theElTrack->GetMSCTrackData();
  G4double* numIALeft = theTrack->GetNumIALeft();
  G4double* mfp = theTrack->GetMFP();

  std::lock_guard<std::mutex> lock(DebugLogMutex());
  out
    << trackId << ','
    << theTrack->GetParentID() << ','
    << stepIndex << ','
    << stage << ','
    << theTrack->GetWinnerProcessIndex() << ','
    << theTrack->GetOnBoundary() << ','
    << ValueOf(theTrack->GetGStepLength()) << ',' << DotOf(theTrack->GetGStepLength()) << ','
    << ValueOf(theElTrack->GetPStepLength()) << ',' << DotOf(theElTrack->GetPStepLength()) << ','
    << ValueOf(mscData->fTrueStepLength) << ',' << DotOf(mscData->fTrueStepLength) << ','
    << ValueOf(mscData->fZPathLength) << ',' << DotOf(mscData->fZPathLength) << ','
    << ValueOf(mscData->fLambtr1) << ',' << DotOf(mscData->fLambtr1) << ','
    << ValueOf(mscData->fPar1) << ',' << DotOf(mscData->fPar1) << ','
    << ValueOf(mscData->fPar2) << ',' << DotOf(mscData->fPar2) << ','
    << ValueOf(mscData->fPar3) << ',' << DotOf(mscData->fPar3) << ','
    << ValueOf(numIALeft[0]) << ',' << DotOf(numIALeft[0]) << ','
    << ValueOf(numIALeft[1]) << ',' << DotOf(numIALeft[1]) << ','
    << ValueOf(numIALeft[2]) << ',' << DotOf(numIALeft[2]) << ','
    << ValueOf(mfp[0]) << ',' << DotOf(mfp[0]) << ','
    << ValueOf(mfp[1]) << ',' << DotOf(mfp[1]) << ','
    << ValueOf(mfp[2]) << ',' << DotOf(mfp[2]) << ','
    << ValueOf(theTrack->GetEKin()) << ',' << DotOf(theTrack->GetEKin()) << ','
    << ValueOf(theTrack->GetEnergyDeposit()) << ',' << DotOf(theTrack->GetEnergyDeposit()) << ','
    << returnFlag
    << '\n';
  out.flush();
}

}  // namespace


// Note: pStepLength will be set here i.e. this is the first access to it that
//       will clear the previous step value.
void G4HepEmElectronManager::HowFar(struct G4HepEmData* hepEmData, struct G4HepEmParameters* hepEmPars, G4HepEmTLData* tlData) {
  G4HepEmElectronTrack* theElTrack = tlData->GetPrimaryElectronTrack();
  G4HepEmTrack* theTrack = theElTrack->GetTrack();
  // Sample the `number-of-interaction-left`
  for (int ip=0; ip<3; ++ip) {
    if (theTrack->GetNumIALeft(ip)<=0.) {
      theTrack->SetNumIALeft(-G4HepEmLog(tlData->GetRNGEngine()->flat()), ip);
    }
  }
  HowFar(hepEmData, hepEmPars, theElTrack, tlData->GetRNGEngine());
}


void G4HepEmElectronManager::HowFarToDiscreteInteraction(struct G4HepEmData* hepEmData, struct G4HepEmParameters* hepEmPars, G4HepEmElectronTrack* theElTrack) {
  int indxWinnerProcess = -1;  // init to continous
  // === 1. Continuous energy loss limit
  G4double pStepLength     = kALargeValue;
  G4HepEmTrack* theTrack = theElTrack->GetTrack();
  const G4double   theEkin = theTrack->GetEKin();
  const G4double  theLEkin = theTrack->GetLogEKin();
  const int       theIMC = theTrack->GetMCIndex();
  const bool  isElectron = (theTrack->GetCharge() < 0.0);

  const G4HepEmElectronData* theElectronData = isElectron
                                               ? hepEmData->fTheElectronData
                                               : hepEmData->fThePositronData;
  //
  const G4double range  = GetRestRange(theElectronData, theIMC, theEkin, theLEkin);
  theElTrack->SetRange(range);
  const G4double frange = hepEmPars->fFinalRange;
  const G4double drange = hepEmPars->fDRoverRange;
  pStepLength = (range > frange)
                ? (G4double)(range*drange + frange*(1.0-drange)*(2.0-frange/range))
                : range;
//  std::cout << " pStepLength = " << pStepLength << " range = " << range << " frange = " << frange << std::endl;
  // === 2. Discrete limits due to eestricted Ioni and Brem (accounting e-loss)
  const int theImat = (hepEmData->fTheMatCutData->fMatCutData[theIMC]).fHepEmMatIndex;
  G4double mxSecs[3];
  // ioni, brem and annihilation to 2 gammas (only for e+)
  mxSecs[0] = GetRestMacXSecForStepping(theElectronData, theIMC, theEkin, theLEkin, true);
  mxSecs[1] = GetRestMacXSecForStepping(theElectronData, theIMC, theEkin, theLEkin, false);
  mxSecs[2] = (isElectron)
              ? 0.0
              : ComputeMacXsecAnnihilationForStepping(theEkin, hepEmData->fTheMaterialData->fMaterialData[theImat].fElectronDensity);
  // compute mfp and see if we need to sample the `number-of-interaction-left`
  // before we use it to get the current discrete proposed step length
  for (int ip=0; ip<3; ++ip) {
    const G4double mxsec = mxSecs[ip];
    const G4double   mfp = (mxsec>0.) ? (G4double)(1./mxsec) : kALargeValue;
    // save the mac-xsec for the update of the `number-of-interaction-left`:
    // the `number-of-intercation-left` should be updated in the along-step-action
    // after the MSC has changed the step.
    theTrack->SetMFP(mfp, ip);
    // sample the proposed step length
    const G4double dStepLimit = mfp*theTrack->GetNumIALeft(ip);
    if (dStepLimit<pStepLength) {
      pStepLength = dStepLimit;
      indxWinnerProcess = ip;
    }
  }

  theElTrack->SetPStepLength(pStepLength);
  theTrack->SetWinnerProcessIndex(indxWinnerProcess);
  theTrack->SetGStepLength(pStepLength);
}

void G4HepEmElectronManager::HowFarToMSC(struct G4HepEmData* hepEmData, struct G4HepEmParameters* hepEmPars, G4HepEmElectronTrack* theElTrack, G4HepEmRandomEngine* rnge) {
  //
  // Now MSC is called to see:
  // - if it limits the (true, i.e. physical) step length further
  // Then we perform the physical --> geometric step length conversion here:
  //  - it provides the projection of the transport vector along the original
  //    direction.
  // Note, this later also part of the MSC model and might also limit the true
  // step length further (see my note inside ConvertTrueToGeometricLength though).
  // Therefore, the check if MSC limited the step must be done after
  // the physical -->  geometric (i.e. true to geom.) conversion.
  //
#ifndef NOMSC
  G4double pStepLength     = theElTrack->GetPStepLength();
  const G4double range     = theElTrack->GetRange();
  G4HepEmTrack* theTrack = theElTrack->GetTrack();
  const G4double   theEkin = theTrack->GetEKin();
  const G4double  theLEkin = theTrack->GetLogEKin();
  const int       theIMC = theTrack->GetMCIndex();
  const bool  isElectron = (theTrack->GetCharge() < 0.0);

  const G4HepEmElectronData* theElectronData = isElectron
                                               ? hepEmData->fTheElectronData
                                               : hepEmData->fThePositronData;

  const int theImat = (hepEmData->fTheMatCutData->fMatCutData[theIMC]).fHepEmMatIndex;

  G4HepEmMSCTrackData* mscData = theElTrack->GetMSCTrackData();
  // init some mscData for the case if we skipp calling msc due to very small step
  mscData->fTrueStepLength      = pStepLength;
  mscData->fZPathLength         = pStepLength;
  mscData->fIsActive            = false;
  mscData->SetDisplacement(0., 0., 0.);
  mscData->SetNewDirection(0., 0., 1.);
  // no msc in case of very small steps
  const G4double kGeomMinLength = 5.E-8; // 0.05 [nm]
  if (pStepLength > kGeomMinLength && theEkin > 1.0E-3) {
    mscData->fIsActive = true;
    // compute the fist transport mean free path
    mscData->fLambtr1  = GetTransportMFP(theElectronData, theImat, theEkin, theLEkin);
    G4HepEmElectronInteractionUMSC::StepLimit(hepEmData, hepEmPars, mscData, theEkin, theImat, range,
                                              theTrack->GetSafety(), theTrack->GetOnBoundary(), isElectron, rnge);
    // If msc limited the true step length, then the G4HepEmMSCTrackData::fTrueStepLength member of
    // the input electron track is < pStepLengt. Otherwise its = pStepLengt.
    // Call the True --> Geometric conversion since that might limits further the true step Length:
    //   - convert the physical step length to geometrical one. The result will be
    //     written into mscData::fZPathLength.
    ConvertTrueToGeometricLength(hepEmData, mscData, theEkin, range, theIMC, isElectron);
    // check now if msc limited the step:
    const G4double mscTruStepLength = mscData->fTrueStepLength;
    if (mscTruStepLength < pStepLength) {
      // indicate continuous step limit as msc limited the step and set the new pStepLength
      theTrack->SetWinnerProcessIndex(-2);
      pStepLength = mscTruStepLength;
      theElTrack->SetPStepLength(pStepLength);
    }
    // set geometrical step length (protect agains wrong conversion, i.e. if gL > pL)
    theTrack->SetGStepLength(G4HepEmMin(mscData->fZPathLength, pStepLength));
  }
#endif
}

void G4HepEmElectronManager::HowFar(struct G4HepEmData* hepEmData, struct G4HepEmParameters* hepEmPars, G4HepEmElectronTrack* theElTrack, G4HepEmRandomEngine* rnge) {
  G4HepEmTrack* theTrack = theElTrack->GetTrack();
  const int trackId = theTrack->GetID();
  const bool doDebug = ShouldDebugTrack(trackId);
  const int stepIndex = doDebug ? GetDebugStepIndex(trackId) : -1;
  if (doDebug) {
    SetDebugContextFromTrack(theTrack, stepIndex);
  }
  HowFarToDiscreteInteraction(hepEmData, hepEmPars, theElTrack);
  HowFarToMSC(hepEmData, hepEmPars, theElTrack, rnge);
  if (doDebug) {
    ClearDebugContext();
  }
}

void G4HepEmElectronManager::UpdatePStepLength(G4HepEmElectronTrack* theElTrack) {
  G4HepEmTrack*   theTrack = theElTrack->GetTrack();
  const G4double gStepLength = theTrack->GetGStepLength();
  G4double pStepLength       = gStepLength;
  // call MSC::ConvertGeometricToTrueLength that will provide the true (i.e. physical)
  // step length in the G4HepEmMSCTrackData::fTrueStepLength member.
  // NOTE: in case the step was NOT limited by boundary, we know the true step length since
  //       the particle went as far as we expected.
#ifndef NOMSC
  const G4double        theRange = theElTrack->GetRange();
  G4HepEmMSCTrackData* mscData = theElTrack->GetMSCTrackData();
  if (mscData->fIsActive) {
    pStepLength = mscData->fTrueStepLength;
    // if we hit boundary or stopped before we wanted for any reasons: convert geom. -> true
    if (gStepLength < mscData->fZPathLength) {
      // the converted geom --> true step Length will be written into mscData::fTrueStepLength
      ConvertGeometricToTrueLength(mscData, theRange, gStepLength);
      // protect against wrong true --> geom --> true conevrsion: physical step
      // cannot be longer than before converted to geometrical
      pStepLength = G4HepEmMin(pStepLength, mscData->fTrueStepLength);
      // store the final true step length value
      mscData->fTrueStepLength = pStepLength;
    }
    // optimisation: do not sample msc and dispalcement in case of last (rangeing out) or short steps
    const G4double kGeomMinLength = 5.E-8; // 0.05 [nm]
    if (pStepLength <= kGeomMinLength || theRange <= pStepLength) {
      mscData->fIsActive = false;
    }
  }
#endif
  // set the results of the geom ---> true in the primary e- etrack
  theElTrack->SetPStepLength(pStepLength);
}

void G4HepEmElectronManager::UpdateNumIALeft(G4HepEmElectronTrack* theElTrack) {
  const G4double pStepLength = theElTrack->GetPStepLength();
  G4HepEmTrack*   theTrack = theElTrack->GetTrack();
  G4double*    numInterALeft = theTrack->GetNumIALeft();
  G4double*       preStepMFP = theTrack->GetMFP();
  numInterALeft[0] -= RegularizedNumIADecrement(pStepLength, preStepMFP[0]);
  numInterALeft[1] -= RegularizedNumIADecrement(pStepLength, preStepMFP[1]);
  numInterALeft[2] -= RegularizedNumIADecrement(pStepLength, preStepMFP[2]);
}

void G4HepEmElectronManager::ConfigureNumIALeftDerivativeRegularization(G4double mfpFloor) {
  NumIALeftDerivativeMfpFloor() = GET_VALUE(mfpFloor) > 0.0 ? mfpFloor : static_cast<G4double>(0.0);
}

void G4HepEmElectronManager::ConfigureConversionDerivativeRegularization(G4double epsilon) {
  ConversionDerivativeEpsilon() = GET_VALUE(epsilon) > 0.0 ? epsilon : static_cast<G4double>(0.0);
}

bool G4HepEmElectronManager::ApplyMeanEnergyLoss(struct G4HepEmData* hepEmData, struct G4HepEmParameters* hepEmPars, G4HepEmElectronTrack* theElTrack) {
  const G4double pStepLength = theElTrack->GetPStepLength();

  G4HepEmTrack* theTrack = theElTrack->GetTrack();
  const bool  isElectron = (theTrack->GetCharge() < 0.0);
  const G4double   theEkin = theTrack->GetEKin();
  const G4double  theRange = theElTrack->GetRange();
  // 0. stop tracking when reached the end (i.e. it has been ranged out by the limit)
  // @TODO: actually the tracking cut is around 1 keV and the min-table energy is 100 eV so the second should never
  //        under standard EM constructor configurations
  if (pStepLength >= theRange || theEkin <= hepEmPars->fMinLossTableEnergy) {
    // stop and deposit the remaining energy
    theTrack->SetEnergyDeposit(theEkin);
    theTrack->SetEKin(0.0);
    return true;
  }
  // 1. try linear energy loss approximation:
  const G4HepEmElectronData* elData = isElectron
                                      ? hepEmData->fTheElectronData
                                      : hepEmData->fThePositronData;
   // NOTE: this is the pre-step IMC !!!
  const int      theIMC = theTrack->GetMCIndex();
  const G4double theLEkin = theTrack->GetLogEKin();
  G4double eloss = pStepLength*GetRestDEDX(elData, theIMC, theEkin, theLEkin);
  // 2. use integral if linear energy loss is over the limit fraction
  if (eloss > theEkin*hepEmPars->fLinELossLimit) {
    const G4double postStepRange = theRange - pStepLength;
    eloss = theEkin - GetInvRange(elData, theIMC, postStepRange);
  }
  eloss = G4HepEmMax(eloss, 0.0);
  if (eloss >= theEkin) {
    eloss = theEkin;
    theTrack->SetEKin(0);
    theTrack->SetEnergyDeposit(eloss);
    return true;
  }
  // 3. Compute the energy after the mean energy loss.
  G4double theEkinAfterMeanEloss = theEkin - eloss;
  theTrack->SetEKin(theEkinAfterMeanEloss);
  theTrack->SetEnergyDeposit(eloss);
  return false;
}

void G4HepEmElectronManager::SampleMSC(struct G4HepEmData* hepEmData, struct G4HepEmParameters* hepEmPars, G4HepEmElectronTrack* theElTrack, G4HepEmRandomEngine* rnge) {
#ifndef NOMSC
  const G4double pStepLength = theElTrack->GetPStepLength();
  G4HepEmTrack*   theTrack = theElTrack->GetTrack();
  const int dbgTrackId = theTrack->GetID();
  if (ShouldDebugTrack(dbgTrackId)) {
    G4HepEmElectronInteractionUMSC::SetDebugContext(
        dbgTrackId,
        theTrack->GetParentID(),
        GetDebugStepIndex(dbgTrackId),
        theTrack->GetWinnerProcessIndex(),
        theTrack->GetOnBoundary());
  } else {
    G4HepEmElectronInteractionUMSC::ClearDebugContext();
  }
  const bool    isElectron = (theTrack->GetCharge() < 0.0);
  const int         theIMC = theTrack->GetMCIndex();
  const G4double preStepEkin = theElTrack->GetPreStepEKin();
  const G4double    theRange = theElTrack->GetRange();

  const G4HepEmElectronData* elData = isElectron
                                      ? hepEmData->fTheElectronData
                                      : hepEmData->fThePositronData;

  //
  //
  // Complete here the MSC part by computing the net angular deflection and dispalcement
  //
  // Smaple scattering in MSC and compute the new direction and displacement vectors (if any)
  // The new direction and dispalcement vectors, proposed by MSC, are given in mscData::fDirection and
  // mscData::fDisplacement.
  const G4double kTLimitMinfix = 1.0E-8; // 0.01 [nm] 1.0E-8 [mm]
  const G4double kTauSmall     = 1.0e-16;
  G4HepEmMSCTrackData* mscData = theElTrack->GetMSCTrackData();
  if (mscData->fIsActive && (pStepLength > G4HepEmMax(kTLimitMinfix, kTauSmall*mscData->fLambtr1))) {
    // only to make sure that we also use E2 = E1 under the same condition as in G4
    G4double postStepEkin  = preStepEkin;
    G4double postStepLEkin = theElTrack->GetPreStepLogEKin();
#if G4VERSION_NUM >= 1100
    if (pStepLength > theRange*0.01)
#endif
    {
      // At this point, we have only computed the mean energy loss. Query the
      // track and if energy loss fluctuations are *not* active, we safe a log
      // call in the next step.
      postStepEkin  = theTrack->GetEKin();
      postStepLEkin = theTrack->GetLogEKin();
    }
    // sample msc scattering:
    // - compute the fist transport mean free path at the post-step energy point
    const int           theImat = (hepEmData->fTheMatCutData->fMatCutData[theIMC]).fHepEmMatIndex;
    const G4double postStepTr1mfp = GetTransportMFP(elData, theImat, postStepEkin, postStepLEkin);
    // - sample scattering: including net angular deflection and lateral dispacement that will be
    //                      written into mscData::fDirection and mscData::fDisplacement
    G4HepEmElectronInteractionUMSC::SampleScattering(hepEmData, mscData, pStepLength, preStepEkin, mscData->fLambtr1, postStepEkin, postStepTr1mfp,
                                    theImat, isElectron, rnge);
    // NOTE: displacement will be applied in the caller where we have access to the required Geant4 functionality
    //       (and if its length is longer than a small minimal length and we are not ended up on boundary)
    //
    // rotate direction and displacement vectors (if any) and update new direction of the primary
    if (!(mscData->fIsNoScatteringInMSC)) {
      G4double dirBefore[3] = {mscData->fDirection[0], mscData->fDirection[1], mscData->fDirection[2]};
      G4double refDir[3] = {theTrack->GetDirection()[0], theTrack->GetDirection()[1], theTrack->GetDirection()[2]};
      const G4double up = std::sqrt(refDir[0] * refDir[0] + refDir[1] * refDir[1]);
      RotateToReferenceFrame(mscData->fDirection, theTrack->GetDirection());
      G4HepEmElectronInteractionUMSC::LogRotationDebug(
          "samplemsc_rotate_direction", dirBefore, mscData->fDirection, refDir, up);
      if (mscData->fIsDisplace) {
        G4double dispBefore[3] = {mscData->fDisplacement[0], mscData->fDisplacement[1], mscData->fDisplacement[2]};
        RotateToReferenceFrame(mscData->fDisplacement, theTrack->GetDirection());
        G4HepEmElectronInteractionUMSC::LogRotationDebug(
            "samplemsc_rotate_displacement", dispBefore, mscData->fDisplacement, refDir, up);
      }
      // upadte new direction
      theTrack->SetDirection(mscData->fDirection);
    }
  }
  G4HepEmElectronInteractionUMSC::ClearDebugContext();
#endif
}

bool G4HepEmElectronManager::SampleLossFluctuations(struct G4HepEmData* hepEmData, struct G4HepEmParameters* hepEmPars, G4HepEmElectronTrack* theElTrack, G4HepEmRandomEngine* rnge) {
  const G4double pStepLength = theElTrack->GetPStepLength();
  G4HepEmTrack*   theTrack = theElTrack->GetTrack();
  const bool    isElectron = (theTrack->GetCharge() < 0.0);
  const int         theIMC = theTrack->GetMCIndex();

  const G4double thePreStepEkin = theElTrack->GetPreStepEKin();

  // Previously ApplyMeanEnergyLoss computed the mean energy loss and stored the
  // result into the track.
  G4double finalEkin = theTrack->GetEKin();
  G4double eloss     = theTrack->GetEnergyDeposit();
  // sample energy loss fluctuations
#ifndef NOFLUCTUATION
  const G4double kFluctParMinEnergy  = 1.E-5; // 10 eV
  if (eloss > kFluctParMinEnergy) {
    const G4HepEmMCCData& theMatCutData = hepEmData->fTheMatCutData->fMatCutData[theIMC];
    const G4double elCut   = theMatCutData.fSecElProdCutE;
    const int    theImat = theMatCutData.fHepEmMatIndex;
    const G4double meanExE = hepEmData->fTheMaterialData->fMaterialData[theImat].fMeanExEnergy;
    //
    const G4double tmax = isElectron ? (G4double)(0.5*thePreStepEkin) : thePreStepEkin;
    const G4double tcut = G4HepEmMin(elCut, tmax);
    eloss = G4HepEmElectronEnergyLossFluctuation::SampleEnergyLossFLuctuation(thePreStepEkin, tcut, tmax,
                                                  meanExE, pStepLength, eloss, rnge);
    eloss = G4HepEmMax(eloss, 0.0);
    // Update the final kinetic energy after loss fluctuations.
    finalEkin = thePreStepEkin - eloss;
  }
#endif
  //
  // Check if the final kinetic energy drops below the tracking cut and stop.
  if (finalEkin <= hepEmPars->fElectronTrackingCut) {
    eloss     = thePreStepEkin;
    finalEkin = 0.0;
    theTrack->SetEKin(finalEkin);
    theTrack->SetEnergyDeposit(eloss);
    return true;
  }
  theTrack->SetEKin(finalEkin);
  theTrack->SetEnergyDeposit(eloss);
  return false;
}

// Here I can have my own transportation to be called BUT at the moment I cannot
// skip the G4Transportation if I do it by myself !!!

// Note: energy deposit will be set here i.e. this is the first access to it that
//       will clear the previous step value.
bool G4HepEmElectronManager::PerformContinuous(struct G4HepEmData* hepEmData, struct G4HepEmParameters* hepEmPars, G4HepEmElectronTrack* theElTrack, G4HepEmRandomEngine* rnge) {
  G4HepEmTrack* theTrack = theElTrack->GetTrack();
  const int trackId = theTrack->GetID();
  const bool doDebug = ShouldDebugTrack(trackId);
  const int stepIndex = doDebug ? GetDebugStepIndex(trackId) : -1;
  if (doDebug) {
    SetDebugContextFromTrack(theTrack, stepIndex);
  }

  theElTrack->SavePreStepEKin();
  //
  // === 1. MSC should be invoked to obtain the physics step Length
  UpdatePStepLength(theElTrack);
  LogPerformContinuousCheckpoint("after_UpdatePStepLength", stepIndex, -1, theElTrack);
  const G4double pStepLength = theElTrack->GetPStepLength();

  if (pStepLength<=0.0) {
    LogPerformContinuousCheckpoint("return_pStepLength_le_zero", stepIndex, 0, theElTrack);
    if (doDebug) {
      AdvanceDebugStepIndex(trackId);
      ClearDebugContext();
    }
    return false;
  }
  // compute the energy loss first based on the new step length: it will be needed in the
  // MSC scatteirng and displacement computation here as well (that is done only if not
  // the last step with the particle).
  // But update the number of interaction length left before.
  //
  // === 2. The `number-of-interaction-left` needs to be updated based on the actual
  //        physical step Length
  UpdateNumIALeft(theElTrack);
  LogPerformContinuousCheckpoint("after_UpdateNumIALeft", stepIndex, -1, theElTrack);
  //
  // === 3. Continuous energy loss needs to be computed
  bool stopped = ApplyMeanEnergyLoss(hepEmData, hepEmPars, theElTrack);
  LogPerformContinuousCheckpoint("after_ApplyMeanEnergyLoss", stepIndex, stopped ? 1 : 0, theElTrack);
  if (stopped) {
    if (doDebug) {
      AdvanceDebugStepIndex(trackId);
      ClearDebugContext();
    }
    return true;
  }

  // === 4. Sample MSC direction change and displacement.
  SampleMSC(hepEmData, hepEmPars, theElTrack, rnge);
  LogPerformContinuousCheckpoint("after_SampleMSC", stepIndex, -1, theElTrack);

  // === 5. Sample loss fluctuations.
  const bool stoppedAfterFluct = SampleLossFluctuations(hepEmData, hepEmPars, theElTrack, rnge);
  LogPerformContinuousCheckpoint("after_SampleLossFluctuations", stepIndex, stoppedAfterFluct ? 1 : 0, theElTrack);
  if (doDebug) {
    AdvanceDebugStepIndex(trackId);
    ClearDebugContext();
  }
  return stoppedAfterFluct;
}


bool G4HepEmElectronManager::CheckDelta(struct G4HepEmData* hepEmData, G4HepEmTrack* theTrack, G4double rand) {
  const bool isElectron = (theTrack->GetCharge() < 0.0);
  const G4HepEmElectronData* elData = isElectron
                                      ? hepEmData->fTheElectronData
                                      : hepEmData->fThePositronData;
  const int iDProc      = theTrack->GetWinnerProcessIndex();
  const int theIMC      = theTrack->GetMCIndex();
  const int theMatIndex = hepEmData->fTheMatCutData->fMatCutData[theIMC].fHepEmMatIndex;
  const G4double theEkin  = theTrack->GetEKin();
  const G4double theLEkin = theTrack->GetLogEKin();
  const G4double mxsec = (iDProc<2)
                      ? GetRestMacXSec(elData, theIMC, theEkin, theLEkin, iDProc==0)
                      : ComputeMacXsecAnnihilation(theEkin, hepEmData->fTheMaterialData->fMaterialData[theMatIndex].fElectronDensity);
  return mxsec <= 0.0 || rand > mxsec*theTrack->GetMFP(iDProc);
}

void G4HepEmElectronManager::PerformDiscrete(struct G4HepEmData* hepEmData, struct G4HepEmParameters* hepEmPars, G4HepEmTLData* tlData) {
  G4HepEmElectronTrack* theElTrack = tlData->GetPrimaryElectronTrack();
  G4HepEmTrack*   theTrack = theElTrack->GetTrack();
  const bool isElectron = (theTrack->GetCharge() < 0.0);

  // 1. check if discrete process limited the step return otherwise (i.e. if
  //      continous or boundary process limited the step)
  const int iDProc = theTrack->GetWinnerProcessIndex();
  if (iDProc < 0 || theTrack->GetOnBoundary()) {
    return;
  }
  // reset number of interaction left for the winner discrete process
  theTrack->SetNumIALeft(-1.0, iDProc);

  // 2. check if delta interaction happens instead of the real discrete process
  if (CheckDelta(hepEmData, theTrack, tlData->GetRNGEngine()->flat())) {
    return;
  }

  // 3. perform the discrete part of the winner interaction
  const G4double theEkin = theTrack->GetEKin();
  switch (iDProc) {
    case 0: // invoke ioni (for e-/e+):
            G4HepEmElectronInteractionIoni::Perform(tlData, hepEmData, isElectron);
            break;
    case 1: // invoke brem (for e-/e+): either SB- or Rel-Brem
            G4HepEmElectronInteractionBrem::Perform(tlData, hepEmData, isElectron, theEkin < hepEmPars->fElectronBremModelLim);
            break;
    case 2: // invoke annihilation (in-flight) for e+
            G4HepEmPositronInteractionAnnihilation::Perform(tlData, false);
            break;
  }
}

void G4HepEmElectronManager::Perform(struct G4HepEmData* hepEmData, struct G4HepEmParameters* hepEmPars, G4HepEmTLData* tlData) {
  G4HepEmElectronTrack* theElTrack = tlData->GetPrimaryElectronTrack();
  G4HepEmTrack*   theTrack = theElTrack->GetTrack();
  // Set default values to cover all early returns due to protection against
  // zero step lengths, conversion errors, etc.
  theTrack->SetEnergyDeposit(0);
  theElTrack->SetPStepLength(theTrack->GetGStepLength());
  const bool isElectron = (theTrack->GetCharge() < 0.0);

  if (theTrack->GetGStepLength()<=0.) return;

  bool stopped = PerformContinuous(hepEmData, hepEmPars, theElTrack, tlData->GetRNGEngine());
  if (stopped) {
    // call annihilation for e+ !!!
    if (!isElectron) {
      G4HepEmPositronInteractionAnnihilation::Perform(tlData, true);
    }
    return;
  }

  // === 4. Discrete part of the interaction (if any)
  PerformDiscrete(hepEmData, hepEmPars, tlData);
}


G4double  G4HepEmElectronManager::GetRestRange(const struct G4HepEmElectronData* elData, const int imc, const G4double ekin, const G4double lekin) {
  const int numELossData = elData->fELossEnergyGridSize;
  const int iRangeStarts = 5*numELossData*imc;
  // use the G4HepEmRunUtils function for interpolation
  const G4double     range = GetSplineLog(numELossData, elData->fELossEnergyGrid, &(elData->fELossData[iRangeStarts]), ekin, lekin, elData->fELossLogMinEkin, elData->fELossEILDelta);
  return G4HepEmMax(0.0, range);
}


G4double  G4HepEmElectronManager::GetRestDEDX(const struct G4HepEmElectronData* elData, const int imc, const G4double ekin, const G4double lekin) {
  const int numELossData = elData->fELossEnergyGridSize;
  const int  iDEDXStarts = numELossData*(5*imc + 2); // 5*imc*numELossData is where range-start + 2*numELossData
  // use the G4HepEmRunUtils function for interpolation
  const G4double      dedx = GetSplineLog(numELossData, elData->fELossEnergyGrid, &(elData->fELossData[iDEDXStarts]), ekin, lekin, elData->fELossLogMinEkin, elData->fELossEILDelta);
  return G4HepEmMax(0.0, dedx);
}


G4double  G4HepEmElectronManager::GetInvRange(const struct G4HepEmElectronData* elData, int imc, G4double range) {
  const int numELossData = elData->fELossEnergyGridSize;
  const int iRangeStarts = 5*numELossData*imc;
  // low-energy approximation
  const G4double minRange = elData->fELossData[iRangeStarts];
  if (range<minRange) {
    const G4double dum = range/minRange;
    return G4HepEmMax(0.0, elData->fELossEnergyGrid[0]*dum*dum);
  }
  // use the G4HepEmRunUtils function for finding the range bin index and for interpolation
  // find `i`, lower index of the range such that R_{i} <= r < R_{i+1}
  const int     iRlow = FindLowerBinIndex(&(elData->fELossData[iRangeStarts]), numELossData, range, 2);
  // interpolate: x,y and sd
  const G4double energy = GetSpline(&(elData->fELossData[iRangeStarts]), elData->fELossEnergyGrid, &(elData->fELossData[iRangeStarts+4*numELossData]), range, iRlow, 2);
  return G4HepEmMax(0.0, energy);
}


G4double  G4HepEmElectronManager::GetRestMacXSec(const struct G4HepEmElectronData* elData, const int imc, const G4double ekin, const G4double lekin, bool isioni) {
  const int iIoniStarts = elData->fResMacXSecStartIndexPerMatCut[imc];
  const int numIoniData = GET_VALUE(elData->fResMacXSecData[iIoniStarts]); // x3 for the 3 values and +5 at the beginning
  const int      iStart = (isioni) ? iIoniStarts : (iIoniStarts + 3*numIoniData + 5);
  const int     numData = GET_VALUE(elData->fResMacXSecData[iStart]);
  const G4double  minEKin = elData->fResMacXSecData[iStart+5];
  if (ekin<minEKin) {return 0.0; }
  // use the G4HepEmRunUtils function for interpolation
  const G4double    mxsec = GetSplineLog(numData, &(elData->fResMacXSecData[iStart+5]), ekin, lekin, elData->fResMacXSecData[iStart+3],elData->fResMacXSecData[iStart+4]);
  return G4HepEmMax(0.0, mxsec);
}


G4double  G4HepEmElectronManager::GetRestMacXSecForStepping(const struct G4HepEmElectronData* elData, const int imc, G4double ekin, G4double lekin, bool isioni) {
  const G4double log08 = -0.22314355131420971;
  const int  iIoniStarts = elData->fResMacXSecStartIndexPerMatCut[imc];
  const int  numIoniData = GET_VALUE(elData->fResMacXSecData[iIoniStarts]); // x3 for the 3 values and +5 at the beginning
  const int       iStart = (isioni) ? iIoniStarts : (iIoniStarts + 3*numIoniData + 5);
  const int      numData = GET_VALUE(elData->fResMacXSecData[iStart]);
  const G4double mxsecMinE = elData->fResMacXSecData[iStart+5];
  const G4double mxsecMaxE = elData->fResMacXSecData[iStart+1];
  const G4double mxsecMaxV = elData->fResMacXSecData[iStart+2];
  if (ekin > mxsecMaxE) {
    // compute reduced energy: we assume that 1/lambda is higher at lower energy so we provide an overestimate
    const G4double ekinReduced = 0.8 * ekin;
    if (ekinReduced < mxsecMaxE) {
      return G4HepEmMax(0.0, mxsecMaxV);
    } else {
      // otherwise we are still on the right side of the maximum so provide 1/lambda at this reduced energy
      ekin   = ekinReduced;
      lekin += log08;
    }
  }
  if (ekin<mxsecMinE) {return 0.0; }
  // use the G4HepEmRunUtils function for interpolation
  const G4double mxsec = GetSplineLog(numData, &(elData->fResMacXSecData[iStart+5]), ekin, lekin, elData->fResMacXSecData[iStart+3], elData->fResMacXSecData[iStart+4]);
  return G4HepEmMax(0.0, mxsec);
}


G4double  G4HepEmElectronManager::GetTransportMFP(const struct G4HepEmElectronData* elData, const int im, const G4double ekin, const G4double lekin) {
  const int numEkin = elData->fELossEnergyGridSize;
  const int iStarts = 2*numEkin*im;
  // use the G4HepEmRunUtils function for interpolation
  const G4double tr1mxsec = G4HepEmMax(0.0, GetSplineLog(numEkin, elData->fELossEnergyGrid, &(elData->fTr1MacXSecData[iStarts]), ekin, lekin, elData->fELossLogMinEkin, elData->fELossEILDelta));
  return tr1mxsec > 0. ? (G4double)(1./tr1mxsec) : kALargeValue;
}


G4double G4HepEmElectronManager::ComputeMacXsecAnnihilation(const G4double ekin, const G4double electronDensity) {
  // Heitler model for e+e- -> 2g annihilation
  const G4double tau   = ekin*kInvElectronMassC2;
  const G4double gam   = tau + 1.0;
  const G4double gam2  = gam*gam;
  const G4double bg2   = tau * (tau+2.0);
  const G4double bg    = std::sqrt(bg2);
  return electronDensity*kPir02*((gam2+4.*gam+1.)*G4HepEmLog(gam+bg) - (gam+3.)*bg) / (bg2*(gam+1.));
}


G4double G4HepEmElectronManager::ComputeMacXsecAnnihilationForStepping(const G4double ekin, const G4double electronDensity) {
  // compute mxsec for the reduced energy (assuming that the mac-xsec decreasing with ekin)
  return ComputeMacXsecAnnihilation(0.8*ekin, electronDensity);
}


void G4HepEmElectronManager::ConvertTrueToGeometricLength(const G4HepEmData* hepEmData, G4HepEmMSCTrackData* mscData,
                                                         G4double ekin, G4double range, int imc, bool iselectron) {
  LogConversionCheckpoint("conv_t2g_enter", -1, mscData, range, DebugNaN(), ekin);
  const G4double convEps = ConversionDerivativeEpsilon();
  mscData->fPar1 = -1.;
  mscData->fPar2 =  0.;
  mscData->fPar3 =  0.;
  // NOTE: in theory, the continuous e-loss limits the step length such its at most the range.
  //       So this line below should never have any effects! Since this is the only part that
  //       might limits the true step length in the true --> geom conversion, we might drop this
  //       that makes possible the decision if MSC limited the step even before this conversion.
  mscData->fTrueStepLength = G4HepEmMin(mscData->fTrueStepLength, range);
  LogConversionCheckpoint("conv_t2g_after_true_clamp", -1, mscData, range, DebugNaN(), ekin);
  //  do the true -> geom transformation
  mscData->fZPathLength = mscData->fTrueStepLength;
  // z = t for very small true-path-length
  const G4double kTlimitMinfix2 = 1.0E-6; // 1 [nm]
  if (mscData->fTrueStepLength < kTlimitMinfix2) {
    LogConversionCheckpoint("conv_t2g_small_true_return", 1, mscData, range, DebugNaN(), ekin);
    return;
  }
  //
  const G4double kTauSmall  = 1.0e-16;
  const G4double kDtrl      = 0.05;
  const G4double tau        = mscData->fTrueStepLength / mscData->fLambtr1;
  if (tau < kTauSmall) {
    mscData->fZPathLength = G4HepEmMin(mscData->fTrueStepLength, mscData->fLambtr1);
    LogConversionCheckpoint("conv_t2g_branch_tau_small", -1, mscData, range, DebugNaN(), ekin);
  } else if (mscData->fTrueStepLength < range * kDtrl) {
    const G4double kTauLim  = 1.0e-6;
    mscData->fZPathLength = (tau < kTauLim)
                            ? (G4double)(mscData->fTrueStepLength * (1. - 0.5 * tau))
                            : (G4double)(mscData->fLambtr1 * (1. - G4HepEmExp(-tau)));
    LogConversionCheckpoint("conv_t2g_branch_short_step", -1, mscData, range, DebugNaN(), ekin);
  } else if (ekin < kElectronMassC2 || mscData->fTrueStepLength == range) {
    mscData->fPar1        = RegularizedRatioKeepPrimal(1.0, range, convEps);
    mscData->fPar2        = RegularizedRatioKeepPrimal(1.0, mscData->fPar1 * mscData->fLambtr1, convEps);
    mscData->fPar3        = 1. + mscData->fPar2;
    mscData->fZPathLength = RegularizedRatioKeepPrimal(1.0, mscData->fPar1 * mscData->fPar3, convEps);
    if (mscData->fTrueStepLength < range) {
      mscData->fZPathLength *= (1. - G4HepEmPow(1. - mscData->fTrueStepLength/range, mscData->fPar3));
    }
    LogConversionCheckpoint("conv_t2g_branch_lowE_or_range", -1, mscData, range, DebugNaN(), ekin);
  } else {
    const G4double rfin     = G4HepEmMax(range - mscData->fTrueStepLength, 0.01 * range);
    const G4HepEmElectronData* elData = iselectron ? hepEmData->fTheElectronData : hepEmData->fThePositronData;
    const G4double t1       = GetInvRange(elData, imc, rfin);
    const int    imat     = (hepEmData->fTheMatCutData->fMatCutData[imc]).fHepEmMatIndex;
    const G4double lambda1  = GetTransportMFP(elData, imat, t1, G4HepEmLog(t1));
    mscData->fPar1        = RegularizedRatioKeepPrimal(mscData->fLambtr1 - lambda1, mscData->fLambtr1 * mscData->fTrueStepLength, convEps); // alpha
    mscData->fPar2        = RegularizedRatioKeepPrimal(1.0, mscData->fPar1 * mscData->fLambtr1, convEps);
    mscData->fPar3        = 1. + mscData->fPar2;
    const G4double zNum = 1. - G4HepEmPow(lambda1/mscData->fLambtr1, mscData->fPar3);
    mscData->fZPathLength = RegularizedRatioKeepPrimal(zNum, mscData->fPar1 * mscData->fPar3, convEps);
    LogConversionCheckpoint("conv_t2g_branch_full_model", -1, mscData, range, DebugNaN(), ekin);
  }
  mscData->fZPathLength = G4HepEmMin(mscData->fZPathLength, mscData->fLambtr1);
  LogConversionCheckpoint("conv_t2g_exit", 0, mscData, range, DebugNaN(), ekin);
}


void G4HepEmElectronManager::ConvertGeometricToTrueLength(G4HepEmMSCTrackData* mscData, G4double range, G4double gStepToConvert) {
  LogConversionCheckpoint("conv_g2t_enter", -1, mscData, range, gStepToConvert, DebugNaN());
  const G4double convEps = ConversionDerivativeEpsilon();
  // step was not defined by transportation: i.e. physics so we know everything,
  // i.e. fTrueStepLength is known because the particle went as far as we expected
  // NOTE: this is done directly now in the caller
//  if (!onBoundary) {
//    return;
//  }
//   return;
  // else: convert geom -> true by using the mean value
  // get the geometrical step length
  mscData->fZPathLength = gStepToConvert;
  // t = z for very small step
  const G4double kTLimitMinfix2 = 1.0E-6; // 1 [nm]
  if (gStepToConvert < kTLimitMinfix2) {
    mscData->fTrueStepLength = gStepToConvert;
    LogConversionCheckpoint("conv_g2t_small_step", 0, mscData, range, gStepToConvert, DebugNaN());
  } else {
    // recalculation
    const G4double kTauSmall = 1.0e-16;
    G4double tlength = gStepToConvert;
    if (gStepToConvert > mscData->fLambtr1 * kTauSmall) {
      if (mscData->fPar1 < 0.) {
        const G4double logTerm = RegularizedLogOneMinusRatioKeepPrimal(gStepToConvert, mscData->fLambtr1, convEps);
        tlength = -mscData->fLambtr1 * logTerm;
        LogConversionCheckpoint("conv_g2t_branch_par1_neg", -1, mscData, range, gStepToConvert, DebugNaN());
      } else {
        const G4double dum = mscData->fPar1 * mscData->fPar3 * gStepToConvert;
        if (dum < 1.) {
          tlength = RegularizedConvertParPosKeepPrimal(mscData->fPar1, mscData->fPar3, gStepToConvert, convEps);
          LogConversionCheckpoint("conv_g2t_branch_par1_pos_dum_lt_1", -1, mscData, range, gStepToConvert, DebugNaN());
        } else {
          tlength = range;
          LogConversionCheckpoint("conv_g2t_branch_par1_pos_dum_ge_1", -1, mscData, range, gStepToConvert, DebugNaN());
        }
      }
      if (tlength < gStepToConvert) {
        tlength = gStepToConvert;
        LogConversionCheckpoint("conv_g2t_apply_monotonic_guard", -1, mscData, range, gStepToConvert, DebugNaN());
      }
    }
    // we make sure in the caller that the results of g->t conversion is not longer
    // than the original true step length
    mscData->fTrueStepLength = tlength;
  }
  LogConversionCheckpoint("conv_g2t_exit", 0, mscData, range, gStepToConvert, DebugNaN());
}
